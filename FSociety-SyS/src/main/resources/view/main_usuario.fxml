<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="miContenedor" prefHeight="550.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.fsocietysys.controller.UsuarioController">
    <children>
        <VBox layoutX="14.0" layoutY="14.0" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label text="Gestión de Usuarios del Sistema">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Filtrar:" />
                        <TextField fx:id="txtFiltroDato" prefHeight="28.0" prefWidth="220.0" promptText="Buscar usuario..." />
                        <Button mnemonicParsing="false" onAction="#listar" styleClass="btn, btn-primary" text="Actualizar" />
                    </children>
                    <padding>
                        <Insets bottom="5.0" top="5.0" />
                    </padding>
                </HBox>
                <HBox spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox prefWidth="350.0" spacing="10.0">
                            <children>
                                <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-background-color: #212529; -fx-text-fill: white; -fx-padding: 8; -fx-background-radius: 4;" text="Datos del Usuario">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <GridPane hgap="8.0" vgap="10.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="100.0" minWidth="10.0" prefWidth="80.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <Label text="Usuario:" />
                                        <TextField fx:id="txtUsuario" promptText="Nombre de usuario" GridPane.columnIndex="1" />
                                        
                                        <Label text="Contraseña:" GridPane.rowIndex="1" />
                                        <PasswordField fx:id="txtClave" promptText="Clave de acceso" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                        
                                        <Label text="Perfil:" GridPane.rowIndex="2" />
                                        <ComboBox fx:id="cbxPerfil" maxWidth="1.7976931348623157E308" promptText="Seleccionar perfil" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                        
                                        <Label text="Estado:" GridPane.rowIndex="3" />
                                        <ComboBox fx:id="cbxEstado" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                        
                                        <HBox alignment="CENTER" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                            <children>
                                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#validarFormulario" styleClass="btn, btn-primary" text="Guardar" HBox.hgrow="ALWAYS" />
                                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#clearForm" styleClass="btn, btn-danger" text="Cancelar" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                    </children>
                                </GridPane>
                                <Label fx:id="lbnMsg" alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" wrapText="true" VBox.vgrow="ALWAYS" />
                            </children>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </VBox>
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <TableView fx:id="tableView" prefHeight="440.0" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>

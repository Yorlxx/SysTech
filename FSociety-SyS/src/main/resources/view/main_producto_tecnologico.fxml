<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="miContenedor" prefHeight="600.0" prefWidth="1180.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.fsocietysys.controller.ProductoTecnologicoController">
    <children>
        <VBox layoutX="14.0" layoutY="14.0" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label text="Catálogo de Productos Tecnológicos (TechStore)">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Filtrar Producto:" />
                        <TextField fx:id="txtFiltroDato" prefHeight="28.0" prefWidth="240.0" promptText="Buscar por nombre, marca o categoría..." />
                        <Button mnemonicParsing="false" onAction="#listar" styleClass="btn, btn-primary" text="Actualizar" />
                    </children>
                    <padding>
                        <Insets bottom="5.0" top="5.0" />
                    </padding>
                </HBox>
                <HBox spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox prefWidth="430.0" spacing="10.0">
                            <children>
                                <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-background-color: #212529; -fx-text-fill: white; -fx-padding: 8; -fx-background-radius: 4;" text="Registro / Edición de Producto Tecnológico">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <GridPane hgap="8.0" vgap="8.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="10.0" prefWidth="110.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="80.0" minWidth="10.0" prefWidth="75.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <Label text="Tipo Producto:" />
                                        <ComboBox fx:id="cbxTipoProducto" maxWidth="1.7976931348623157E308" promptText="Seleccionar tipo" GridPane.columnIndex="1" GridPane.columnSpan="3" />
                                        
                                        <Label text="Nombre:" GridPane.rowIndex="1" />
                                        <TextField fx:id="txtNombreProducto" promptText="Ej. Laptop Gamer Core i7" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1" />
                                        
                                        <Label text="P. Unitario (S/):" GridPane.rowIndex="2" />
                                        <TextField fx:id="txtPUnit" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                        <Label text="P. Anterior:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                        <TextField fx:id="txtPUnitOld" promptText="0.00" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                                        
                                        <Label text="Utilidad (S/):" GridPane.rowIndex="3" />
                                        <TextField fx:id="txtUtilidad" promptText="0.00" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="3" />
                                        
                                        <Label text="Stock Actual:" GridPane.rowIndex="4" />
                                        <TextField fx:id="txtStock" promptText="0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                        <Label text="Stock Ant.:" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                                        <TextField fx:id="txtStockOld" promptText="0" GridPane.columnIndex="3" GridPane.rowIndex="4" />
                                        
                                        <Label text="Marca:" GridPane.rowIndex="5" />
                                        <ComboBox fx:id="cbxMarca" maxWidth="1.7976931348623157E308" promptText="Seleccionar marca" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="5" />
                                        
                                        <Label text="Categoría:" GridPane.rowIndex="6" />
                                        <ComboBox fx:id="cbxCategoria" maxWidth="1.7976931348623157E308" promptText="Seleccionar categoría" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="6" />
                                        
                                        <Label text="Unidad Medida:" GridPane.rowIndex="7" />
                                        <ComboBox fx:id="cbxUnidMedida" maxWidth="1.7976931348623157E308" promptText="Seleccionar unidad" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="7" />
                                        
                                        <HBox alignment="CENTER" spacing="10.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="8">
                                            <children>
                                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#validarFormulario" styleClass="btn, btn-primary" text="Guardar" HBox.hgrow="ALWAYS" />
                                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#clearForm" styleClass="btn, btn-danger" text="Cancelar" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                    </children>
                                </GridPane>
                                <Label fx:id="lbnMsg" alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" wrapText="true" VBox.vgrow="ALWAYS" />
                            </children>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </VBox>
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <TableView fx:id="tableView" prefHeight="480.0" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
